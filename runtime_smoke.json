{
  "mode": "service",
  "start": "go run ./cmd/api",
  "workdir": "backend",
  "env": {
    "APP_ENV": "development",
    "HTTP_ADDR": "127.0.0.1:19502",
    "DB_DRIVER": "sqlite",
    "DATABASE_URL": "file:runtime-smoke?mode=memory&cache=shared",
    "REDIS_ADDR": "127.0.0.1:6379",
